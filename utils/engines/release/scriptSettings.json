{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "MaksIT.Wvc210 Release Script Settings",
  "description": "RepoUtils release pipeline for MaksIT.Wvc210 Avalonia UI.",
  "plugins": [
    {
      "name": "DotNetReleaseVersion",
      "stageLabel": "build",
      "enabled": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.Wvc210.UI\\MaksIT.Wvc210.UI.csproj"
      ]
    },
    {
      "name": "DotNetTest",
      "stageLabel": "test",
      "enabled": true,
      "project": "..\\..\\..\\src\\MaksIT.Wvc210.Tests",
      "resultsDir": "..\\..\\..\\test-results"
    },
    {
      "name": "QualityGate",
      "stageLabel": "qualityGate",
      "enabled": true,
      "coverageThreshold": 0,
      "failOnVulnerabilities": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.Wvc210.UI\\MaksIT.Wvc210.UI.csproj"
      ]
    },
    {
      "name": "DotNetPublish",
      "stageLabel": "build",
      "enabled": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.Wvc210.UI\\MaksIT.Wvc210.UI.csproj"
      ],
      "artifactsDir": "..\\..\\..\\releases"
    },
    {
      "name": "DotNetCreateArchive",
      "stageLabel": "build",
      "enabled": true,
      "zipNamePattern": "maksit-wvc210-{version}.zip"
    },
    {
      "name": "ReleasePublishGuard",
      "stageLabel": "release",
      "enabled": true,
      "branches": [
        "main"
      ],
      "requireExactTagOnHead": true,
      "tagVersionMustMatchDotNetRelease": true,
      "whenRequirementsNotMet": "skip",
      "requireCleanWorkingTree": false,
      "ensureTagOnRemote": false,
      "remoteName": "origin"
    },
    {
      "name": "GitHub",
      "stageLabel": "release",
      "enabled": true,
      "githubSecret": "GitHub",
      "repository": "",
      "releaseNotesFile": "..\\..\\..\\CHANGELOG.md",
      "releaseTitlePattern": "Release {version}",
      "requireReleaseAssets": true
    },
    {
      "name": "DotNetCleanupArtifacts",
      "stageLabel": "release",
      "enabled": true,
      "includePatterns": [
        "*"
      ],
      "excludePatterns": [
        "*.zip"
      ]
    }
  ]
}
