{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "MaksIT.Wvc210 Release Script Settings",
  "description": "Community desktop pipeline. GitHub assets are siblings: portable zip, Windows setup exe, Flatpak. The zip never contains the installer or Flatpak.",
  "plugins": [
    {
      "name": "DotNetReleaseVersion",
      "stageLabel": "build",
      "enabled": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.Wvc210.UI\\MaksIT.Wvc210.UI.csproj"
      ]
    },
    {
      "name": "DotNetTest",
      "stageLabel": "test",
      "enabled": true,
      "project": "..\\..\\..\\src\\MaksIT.Wvc210.Tests",
      "resultsDir": "..\\..\\..\\test-results"
    },
    {
      "name": "QualityGate",
      "stageLabel": "qualityGate",
      "enabled": true,
      "coverageThreshold": 0,
      "failOnVulnerabilities": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.Wvc210.UI\\MaksIT.Wvc210.UI.csproj"
      ]
    },
    {
      "name": "DotNetPublish",
      "stageLabel": "build",
      "enabled": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.Wvc210.UI\\MaksIT.Wvc210.UI.csproj"
      ],
      "artifactsDir": "..\\..\\..\\releases",
      "runtimeIdentifiers": [
        "win-x64",
        "linux-x64"
      ],
      "selfContained": true,
      "publishSingleFile": false
    },
    {
      "name": "DotNetCreateArchive",
      "stageLabel": "build",
      "enabled": true,
      "zipNamePattern": "maksit-wvc210-{version}.zip",
      "portableRuntimeIdentifier": "win-x64"
    },
    {
      "name": "WindowsInstaller",
      "stageLabel": "build",
      "enabled": true,
      "appName": "MaksIT WVC210",
      "manufacturer": "MaksIT",
      "installFolderName": "WVC210",
      "upgradeCode": "9c2e4f71-8b3a-4d56-a1c0-7f3e2d1c0b9a",
      "executableName": "MaksIT.Wvc210.UI.exe",
      "runtimeIdentifier": "win-x64",
      "installScope": "perMachine",
      "iconPath": "..\\..\\..\\src\\MaksIT.Wvc210.UI\\Assets\\icon.ico",
      "exeNamePattern": "maksit-wvc210-{version}.exe"
    },
    {
      "name": "StageLinuxLibVlc",
      "stageLabel": "build",
      "enabled": true,
      "runtimeIdentifier": "linux-x64",
      "wslDistro": "Debian"
    },
    {
      "name": "FlatpakPack",
      "stageLabel": "build",
      "enabled": true,
      "appId": "com.maks_it.wvc210",
      "appName": "MaksIT WVC210",
      "command": "maksit-wvc210",
      "executableName": "MaksIT.Wvc210.UI",
      "runtimeIdentifier": "linux-x64",
      "summary": "Control a WVC210 IP camera",
      "description": "Desktop client for the WVC210 IP camera. Live MJPEG and MPEG/RTSP view, pan-tilt-zoom, presets, and occupancy.",
      "projectLicense": "Apache-2.0",
      "categories": "AudioVideo;Video;",
      "iconPath": "..\\..\\..\\src\\MaksIT.Wvc210.UI\\Assets\\icon.png",
      "metainfoPath": "..\\..\\..\\data\\com.maks_it.wvc210.metainfo.xml",
      "desktopPath": "..\\..\\..\\data\\com.maks_it.wvc210.desktop",
      "finishArgs": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=x11",
        "--socket=pulseaudio",
        "--device=dri",
        "--filesystem=xdg-documents",
        "--filesystem=xdg-pictures"
      ],
      "bundleNamePattern": "maksit-wvc210-{version}.flatpak",
      "buildBundle": true,
      "attachSourceZip": false,
      "wslDistro": "Debian",
      "whenBuilderMissing": "skip"
    },
    {
      "name": "ReleasePublishGuard",
      "stageLabel": "release",
      "enabled": true,
      "branches": [
        "main"
      ],
      "requireExactTagOnHead": true,
      "tagVersionMustMatchDotNetRelease": true,
      "whenRequirementsNotMet": "skip",
      "requireCleanWorkingTree": false,
      "ensureTagOnRemote": false,
      "remoteName": "origin"
    },
    {
      "name": "GitHub",
      "githubSecret": "GitClone",
      "stageLabel": "release",
      "enabled": true,
      "repository": "",
      "releaseNotesFile": "..\\..\\..\\CHANGELOG.md",
      "releaseTitlePattern": "Release {version}",
      "requireReleaseAssets": true
    },
    {
      "name": "CleanupArtifacts",
      "stageLabel": "release",
      "enabled": true,
      "includePatterns": [
        "*"
      ],
      "excludePatterns": [
        "*.zip",
        "*.exe",
        "*.flatpak"
      ]
    }
  ],
  "repoUtilsSecretsShared": "RepoUtilsSecretsShared",
  "repoUtilsSecrets": "RepoUtilsSecrets",
  "vaultRepoUtilsApplication": "Shared"
}
